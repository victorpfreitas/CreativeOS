rules_version = '2';

// Regras de segurança do Firestore para o CreativeOS.
//
// O frontend acessa o banco com o SDK cliente (sujeito a estas regras) usando
// login do Google. As funções server-side (api/) usam o Firebase Admin SDK com
// service account, que IGNORA estas regras — então travar tudo para usuários
// autenticados não quebra as automações.
//
// Aplique no console (Firestore → Regras) ou via:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    // Qualquer usuário autenticado pode ler/escrever os dados do app.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
